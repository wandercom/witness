{
  "name": "@exemplar-stack/witness",
  "version": "0.1.1",
  "description": "witness — TypeScript library + thin HTTP server for human-in-the-loop coordination",
  "license": "MIT",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./server": {
      "types": "./dist/server/http.d.ts",
      "import": "./dist/server/http.js"
    }
  },
  "files": [
    "dist",
    "src",
    "server",
    "migrations",
    "README.md",
    "SPEC.md",
    "ADR-001-extraction.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "server": "tsx server/http.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wandercom/witness.git"
  },
  "homepage": "https://github.com/wandercom/witness#readme",
  "bugs": {
    "url": "https://github.com/wandercom/witness/issues"
  }
}
